{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "passagem.schema.json",
  "title": "Passagem",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "referencia",
    "afirma",
    "registros_citados"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9_]+)*$"
    },
    "referencia": {
      "type": "string",
      "minLength": 1
    },
    "titulo": {
      "type": "string",
      "minLength": 1,
      "description": "Título redigido pelo projeto (não o subtítulo de uma tradução, que pode ter direitos próprios)."
    },
    "texto": {
      "type": "string",
      "description": "Id em dados/textos/ do capítulo lido na tela de leitura (ex.: genesis-01)."
    },
    "conexoes": {
      "type": "array",
      "description": "Ligações que aparecem como card junto a versículos na tela de leitura.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ligacao",
          "versiculos",
          "tema"
        ],
        "properties": {
          "ligacao": {
            "type": "string"
          },
          "versiculos": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "integer",
              "minimum": 1
            }
          },
          "tema": {
            "type": "string",
            "enum": [
              "paralelo",
              "ciencia",
              "leitura_literal",
              "leitura_nao_literal",
              "contexto"
            ]
          },
          "trecho": {
            "type": "string",
            "minLength": 1,
            "description": "Opcional: as palavras exatas do versículo (o primeiro do intervalo) que viram link para esta nota na tela de leitura. Precisam existir no texto do versículo; sem trecho, a nota aparece como ícone no fim do versículo."
          }
        }
      }
    },
    "afirma": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "registros_citados": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "afirmacoes_citadas": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "IDs de dados/afirmacoes/ que esta passagem sustenta — é o que liga o capítulo às Afirmações formais (com datação e ligações), não só à prosa livre de 'afirma'."
    },
    "paralelos_externos": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ligacao"
        ],
        "properties": {
          "ligacao": {
            "type": "string"
          }
        }
      }
    },
    "nenhum_paralelo_conhecido": {
      "type": "boolean",
      "const": true
    }
  },
  "oneOf": [
    {
      "required": [
        "paralelos_externos"
      ]
    },
    {
      "required": [
        "nenhum_paralelo_conhecido"
      ]
    }
  ]
}
