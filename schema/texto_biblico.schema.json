{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "texto_biblico.schema.json",
  "title": "Texto bíblico",
  "description": "Um capítulo da Bíblia numa tradução, versículo a versículo, transcrito de fonte oficial. A tradução tem de permitir a reprodução integral (domínio público ou licença livre); a licença e a atribuição que ela exige ficam registradas aqui e aparecem na tela de leitura.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "livro", "capitulo", "traducao", "versiculos"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "<livro>-<capítulo com dois dígitos>, ex.: genesis-01."
    },
    "livro": { "type": "string", "minLength": 1 },
    "capitulo": { "type": "integer", "minimum": 1 },
    "traducao": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sigla", "nome", "licenca", "atribuicao", "fonte"],
      "properties": {
        "sigla": { "type": "string", "minLength": 1 },
        "nome": { "type": "string", "minLength": 1 },
        "licenca": {
          "type": "string",
          "minLength": 1,
          "description": "A licença como a fonte oficial a declara (ex.: 'Domínio público', 'CC BY-SA 4.0')."
        },
        "atribuicao": {
          "type": "string",
          "minLength": 1,
          "description": "O texto de atribuição exigido pela licença, exatamente como deve aparecer na tela."
        },
        "fonte": {
          "type": "string",
          "pattern": "^https://[^\\s]+$",
          "description": "De onde o texto foi transcrito: página ou arquivo oficial do projeto da tradução."
        },
        "licenca_url": {
          "type": "string",
          "pattern": "^https://[^\\s]+$",
          "description": "Onde a licença foi lida."
        }
      }
    },
    "versiculos": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["n", "texto"],
        "properties": {
          "n": { "type": "integer", "minimum": 1 },
          "texto": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
