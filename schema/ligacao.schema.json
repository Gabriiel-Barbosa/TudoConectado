{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "ligacao.schema.json",
  "title": "Ligação",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "tipo", "entre", "evidencia", "fontes", "o_que_derrubaria", "notas"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9_]+)*$"
    },
    "tipo": {
      "type": "string",
      "minLength": 1,
      "description": "Ver tabela de tipos de ligação na seção 3 da METODOLOGIA.md (ex.: confirma, contradiz, foi_copiado_de)."
    },
    "entre": {
      "description": "Lê-se entre[0] <tipo> entre[1]: o primeiro item é o sujeito (a evidência que confirma, contradiz ou foi copiada) e o segundo é o alvo. A seta do grafo segue essa ordem; validar.js recusa a ordem inversa à do id.",
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "minProperties": 1,
        "maxProperties": 1,
        "properties": {
          "afirmacao": { "type": "string" },
          "registro": { "type": "string" }
        }
      }
    },
    "evidencia": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tipo_de_apoio", "forca", "quem_sustenta"],
      "properties": {
        "tipo_de_apoio": {
          "type": "string",
          "enum": ["texto", "inscricao", "achado_arqueologico", "moedas", "analise_linguistica", "nenhum"]
        },
        "forca": {
          "type": "string",
          "enum": ["bem_estabelecido", "aceito_maioria", "disputado", "poucos", "especulacao"]
        },
        "quem_sustenta": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["nome", "ano"],
            "properties": {
              "nome": { "type": "string", "minLength": 1 },
              "ano": { "type": "integer" }
            }
          }
        }
      }
    },
    "fontes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["nivel", "descricao"],
        "properties": {
          "nivel": { "type": "integer", "minimum": 1, "maximum": 4 },
          "descricao": {
            "type": "string",
            "minLength": 1,
            "description": "Localização exata: capítulo/versículo, coluna/linha, nº de catálogo ou página — nunca só o título do livro."
          },
          "url": {
            "type": "string",
            "pattern": "^https://[^\\s]+$",
            "description": "Opcional. Onde o leitor consulta a fonte: DOI, catálogo oficial, edição digitalizada ou página da editora. Só um endereço que alguém abriu e viu que leva a ESTA obra — nunca um link deduzido. Não entra no hash da conferência: trocar o link não invalida o veredito sobre a fonte."
          }
        }
      }
    },
    "o_que_derrubaria": {
      "type": "string",
      "minLength": 1
    },
    "justificativa_copia": {
      "type": "object",
      "additionalProperties": false,
      "required": ["semelhanca_especifica", "anterioridade_comprovada", "caminho_plausivel"],
      "properties": {
        "semelhanca_especifica": { "type": "string", "minLength": 1 },
        "anterioridade_comprovada": { "type": "string", "minLength": 1 },
        "caminho_plausivel": { "type": "string", "minLength": 1 }
      }
    },
    "notas": {
      "type": ["string", "null"]
    }
  },
  "if": {
    "properties": { "tipo": { "const": "foi_copiado_de" } }
  },
  "then": {
    "required": ["justificativa_copia"]
  }
}
