{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "afirmacao.schema.json",
  "title": "Afirmação",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "texto",
    "registros_envolvidos"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "texto": {
      "type": "string",
      "minLength": 1
    },
    "registros_envolvidos": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "datacao": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "periodo",
          "segundo_quem"
        ],
        "properties": {
          "periodo": {
            "type": "array",
            "description": "Margem [início, fim] em anos; negativo = a.C. Nunca um ponto único no tempo.",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "integer"
            }
          },
          "segundo_quem": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "atemporal": {
      "type": "boolean",
      "const": true,
      "description": "Declara que a afirmação é uma interpretação ou tese sem data própria (ex.: \"os dias de Gênesis 1 não precisam ser de 24 horas\"). Uma afirmação ou tem datacao ou declara atemporal: true — nunca fica sem data por esquecimento (mesmo princípio de nenhum_paralelo_conhecido)."
    }
  },
  "oneOf": [
    {
      "required": [
        "datacao"
      ]
    },
    {
      "required": [
        "atemporal"
      ]
    }
  ]
}
